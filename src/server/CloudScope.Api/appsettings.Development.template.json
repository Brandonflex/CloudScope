{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "CloudScope": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Platform": {
    "Mode": "Auto",
    "StorageProvider": "InMemory",
    "SeedDemoData": true
  },
  "Discovery": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "StartupDelaySeconds": 2
  },
  "Swagger": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "ConnectionStrings": {
    "Redis": ""
  },
  "Azure": {
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "SubscriptionId": "",
    "ResourceGraphScopes": []
  },
  "CosmosDb": {
    "Endpoint": "",
    "Key": "",
    "DatabaseName": "CloudScope",
    "ResourcesContainer": "Resources",
    "GraphContainer": "Graph"
  },
  "AWS": {
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "Region": "us-east-1",
    "AccountId": "",
    "ServiceUrl": ""
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "ApiKey": "",
    "DeploymentName": "gpt-4",
    "MaxTokens": 2000,
    "Temperature": 0.1
  },
  "SignalR": {
    "ConnectionString": ""
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
