{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CloudScope": "Information"
    }
  },
  "AllowedHosts": "*",
  "Platform": {
    "Mode": "Auto",
    "StorageProvider": "Cosmos",
    "SeedDemoData": false
  },
  "Discovery": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "StartupDelaySeconds": 10
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "Redis": ""
  },
  "CosmosDb": {
    "Endpoint": "",
    "Key": "",
    "DatabaseName": "CloudScope",
    "ResourcesContainer": "Resources",
    "GraphContainer": "Graph"
  },
  "AWS": {
    "AccountId": "",
    "Region": "us-east-1",
    "ServiceUrl": ""
  },
  "AzureOpenAI": {
    "DeploymentName": "gpt-4",
    "MaxTokens": 2000,
    "Temperature": 0.1
  },
  "SignalR": {
    "ConnectionString": ""
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
