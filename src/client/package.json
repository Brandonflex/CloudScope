{
  "name": "cloudscope",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "start:mock": "ng serve --proxy-config proxy.mock.json",
    "mock:api": "node mock-api/server.mjs --port 5055",
    "preview:demo": "ng build --configuration development && node mock-api/server.mjs --port 4300 --static dist/cloudscope/browser",
    "preview:mock": "node mock-api/server.mjs --port 4300 --static dist/cloudscope/browser",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.34",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/forms": "^20.3.34",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.34",
    "@angular/platform-browser-dynamic": "^20.3.34",
    "@angular/router": "^20.3.34",
    "@microsoft/signalr": "^8.0.29",
    "chart.js": "^4.5.1",
    "cytoscape": "^3.34.4",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.40",
    "@angular-eslint/builder": "^18.4.3",
    "@angular-eslint/eslint-plugin": "^18.4.3",
    "@angular-eslint/eslint-plugin-template": "^18.4.3",
    "@angular-eslint/template-parser": "^18.4.3",
    "@angular/cli": "^20.3.40",
    "@angular/compiler-cli": "^20.3.34",
    "@eslint/js": "^8.57.1",
    "@types/cytoscape": "^3.21.8",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^18.4.3",
    "eslint": "^8.57.1",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2"
  }
}
